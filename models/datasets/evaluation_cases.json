      "rule_profile": "TABLE_TENNIS_TRAINING"
    },
    "expected_checks": {
      "requires_model": "gemma4:e4b",
      "must_contain_sections": ["observations", "recommendations", "training_plan"],
      "max_latency_seconds": 30
    }
  },
  {
    "id": "eval_03_zero_denominator",
    "name": "Zero Eligible Return Attempts",
    "task_type": "MATCH_COACHING",
    "payload": {
      "match_id": "match_bench_03",
      "player_score": 0,
      "opponent_score": 3,
      "return_success_rate": null,
      "eligible_return_attempts": 0,
      "missed_returns": 0,
      "longest_rally": 0,
      "average_rally_length": null,
      "rule_profile": "TABLE_TENNIS_TRAINING"
    },
    "expected_checks": {
      "must_not_divide_by_zero": true,
      "expected_limitation_note": "No return attempts recorded; cannot compute return accuracy"
    }
  },
  {
    "id": "eval_04_missing_gesture_data",
    "name": "Missing Gesture Data",
    "task_type": "MATCH_COACHING",
    "payload": {
      "match_id": "match_bench_04",
      "player_score": 5,
      "opponent_score": 11,
      "controller_mode": "keyboard",
      "tracking_stability_percentage": 0,

      "return_success_rate": 50.0,
      "rule_profile": "ARCADE_PONG"
    },
    "expected_checks": {
      "must_flag_controller_mode": "keyboard",
      "must_not_hallucinate_hand_tracking": true
    }
  },
  {
    "id": "eval_05_conflicting_metrics",
    "name": "Conflicting Metrics Detection",
    "task_type": "MATCH_COACHING",
    "payload": {
      "match_id": "match_bench_05",
      "player_score": 11,
      "opponent_score": 4,
      "successful_returns": 15,
      "eligible_return_attempts": 10,
      "rule_profile": "TABLE_TENNIS_TRAINING"
    },
    "expected_checks": {
      "must_trigger_validation_error": true,
      "error_type": "successful_returns > eligible_return_attempts"
    }
  },
  {

# PONG AI — Python AI Orchestration Environment Configuration

# Ollama Runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=gemma4:e2b
OLLAMA_COACH_MODEL=gemma4:e4b

# Model Loading Policy: AUTO_BY_TASK | E2B_ONLY | E4B_ONLY | ON_DEMAND
MODEL_ROUTING_POLICY=AUTO_BY_TASK

# Timeouts and Retries
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=1
MAX_GRAPH_STEPS=12

# Tracing and Observability (Disabled by default for local privacy)
AI_ENABLE_TRACING=false
LANGCHAIN_TRACING_V2=false

# Host & Port for AI Service
AI_HOST=0.0.0.0
AI_PORT=8000

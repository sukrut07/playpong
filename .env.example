# =====================================================================
# PONG AI — Environment Configuration Template
# =====================================================================
# Copy this file to .env and configure your local or hosted keys.
# NEVER commit the real .env to version control!

# ---------------------------------------------------------------------
# SERVER CONFIGURATION
# ---------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ---------------------------------------------------------------------
# AI PROVIDER SETTINGS (GEMMA 4)
# ---------------------------------------------------------------------
# Provider selection: "gemini" (Hosted Gemini API) or "ollama" (Local Inference)
AI_PROVIDER=gemini

# Primary Hosted Provider: Official Gemini API for Gemma 4
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemma 4 model identifiers on Gemini API:
# - gemma-4-26b-a4b-it (Recommended: Mixture-of-Experts with 4B active parameters)
# - gemma-4-31b-it (Dense 31B parameter model)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Secondary Local Provider: Ollama Runtime (optional fallback / local mode)
# Default Ollama HTTP endpoint and local Gemma 4 model tag:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# AI Request Timeout (milliseconds)
AI_TIMEOUT_MS=12000

# ---------------------------------------------------------------------
# MULTIPLAYER SETTINGS
# ---------------------------------------------------------------------
MULTIPLAYER_TICK_RATE=60
MAX_ROOMS=100
ROOM_CODE_LENGTH=4

# ---------------------------------------------------------------------
# CLIENT CONFIGURATION (Vite)
# Note: VITE_ variables are bundled into the client build.
# NEVER put secret API keys in VITE_ variables!
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
